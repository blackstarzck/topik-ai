# topik-ai -> v13 Supabase (overlap admin integration, Phase A).
#
# Copy these from the v13 repo's .env.local (do NOT commit real values):
#   v13 NEXT_PUBLIC_SUPABASE_URL             -> VITE_SUPABASE_URL
#   v13 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> VITE_SUPABASE_ANON_KEY   (anon/publishable key ONLY)
#
# When BOTH are set (put them in .env.local, which is gitignored), the admin app
# requires a v13 admin login (Supabase auth). When unset, the app stays in its
# existing mock-only mode (no login). NEVER put the service_role key in this client app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Existing
REACT_APP_TINYMCE_API_KEY=
