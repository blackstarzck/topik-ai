# topik-ai -> v13 Supabase (overlap admin integration, Phase A).
#
# Copy these from the v13 repo's .env.local (do NOT commit real values):
#   v13 NEXT_PUBLIC_SUPABASE_URL             -> VITE_SUPABASE_URL
#   v13 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# When BOTH are set (put them in .env.local, which is gitignored), the admin app
# requires a v13 admin login (Supabase auth). When unset, AuthGate stays in local
# mock pass-through mode (no login), but Supabase-only pages such as Assessment >
# TOPIK writing question bank show error/retry instead of loading JSON fallback.
# NEVER put sb_secret/service_role keys in this client app. Use them only in
# server-side admin scripts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY for v13.
VITE_SUPABASE_ANON_KEY=

# Local/e2e override only. Keep unset for real Supabase integration.
VITE_SUPABASE_DISABLED=

# Existing
REACT_APP_TINYMCE_API_KEY=
