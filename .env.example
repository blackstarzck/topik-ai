# topik-ai -> v13 Supabase (overlap admin integration, Phase A).
#
# Environment routing contract:
#   localhost + Vercel Development -> topik-dev  (fglggyfvzjdsbyckinqa)
#   Vercel Preview + Production    -> topik-prod (eymlabowhfgtxbiqwxqh)
# Keep .env.local on topik-dev. Configure each Vercel target explicitly; changing
# a Vercel env value requires a new deployment before the runtime sees it.
#
# Copy these from the v13 repo's .env.local (do NOT commit real values):
#   v13 NEXT_PUBLIC_SUPABASE_URL             -> VITE_SUPABASE_URL
#   v13 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# When BOTH are set (put them in .env.local, which is gitignored), the admin app
# requires a v13 admin login (Supabase auth). When unset, AuthGate stays in local
# mock pass-through mode (no login), but Supabase-only pages such as Assessment >
# TOPIK writing question bank show error/retry instead of loading JSON fallback.
# NEVER expose sb_secret/service_role keys through VITE_* variables. Use them
# only in server-side admin scripts or server-only functions under /api.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY for v13.
VITE_SUPABASE_ANON_KEY=

# Local/e2e override only. Keep unset for real Supabase integration.
VITE_SUPABASE_DISABLED=

# Existing
REACT_APP_TINYMCE_API_KEY=

# Server-only notification email worker (/api/notifications/dispatch-email).
# Configure these only in server/runtime env, never as VITE_* values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy server-only alias accepted by local scripts/worker. Prefer SUPABASE_SERVICE_ROLE_KEY in production.
SUPABASE_SECRET_KEY=
NOTIFICATION_WORKER_SECRET=
CRON_SECRET=
SITE_URL=

# Server-only on-premise backup report receiver (/api/backups/report).
# BACKUP_REPORT_SECRET must match /etc/topik-backup/report-secret on the
# on-premise server. Generate a separate random secret; never use a Supabase key.
BACKUP_REPORT_SECRET=
# A different secret signs the topik-dev metadata mirror. The mirror Supabase
# credentials are server-only and are never exposed through a VITE_* variable.
BACKUP_MIRROR_REPORT_SECRET=
BACKUP_MIRROR_SUPABASE_URL=
BACKUP_MIRROR_SUPABASE_SERVICE_ROLE_KEY=
BACKUP_MIRROR_SUPABASE_PROJECT_REF=
BACKUP_MIRROR_SUPABASE_EXPECTED_PROJECT_REF=

# Local/e2e data-source override only. Keep unset for real Supabase reads:
# localhost reads the topik-dev metadata mirror and Production reads topik-prod.
VITE_BACKUP_SOURCE=

# Server-only auth email sync (/api/auth-email/sync). Pushes admin-edited auth
# email templates to Supabase Auth via the Management API. Never expose as VITE_*.
#   SUPABASE_MANAGEMENT_API_TOKEN — Supabase personal access token with project
#     config write access. Falls back to SUPABASE_ACCESS_TOKEN (used by db scripts).
#   SUPABASE_PROJECT_REF — target project ref. The code fallback is dev-only;
#     Vercel Preview/Production must set the topik-prod ref explicitly.
SUPABASE_MANAGEMENT_API_TOKEN=
SUPABASE_PROJECT_REF=
# Mandatory for every DB write. Must exactly match SUPABASE_PROJECT_REF.
SUPABASE_EXPECTED_PROJECT_REF=
# Additional production write confirmation. Set to the topik-prod ref only for
# the one command that is intentionally mutating production.
SUPABASE_PRODUCTION_CONFIRM=
# Optional non-secret display name used by scripts/db/bootstrap-admin.mjs.
E2E_ADMIN_DISPLAY_NAME=

# Operator-only smoke checks. This is not consumed by the browser app or worker.
TOPIK_AI_PRODUCTION_URL=

# Temporary for integration with Topik AI Backend (Overlap Project)
API_BASE_URL=
API_ACCOUNT_INFO_EMAIL=
API_ACCOUNT_INFO_PASSWORD=
# Cron 자동 적재(GET /api/writing-tasks/ingest)가 RPC 호출에 쓰는 시스템 actor.
# content_admin/platform_admin 권한 uuid여야 한다(서버 전용). cron 인증은 CRON_SECRET 재사용.
# ⚠️ 자동 적재 cron(매일)이 동작하려면 다음이 모두 설정돼야 한다(하나라도 없으면 매일
#    조용히 no-op 후 Vercel 로그에 console.error만 남음):
#    CRON_SECRET + INGEST_SYSTEM_ACTOR_ID + SUPABASE_SERVICE_ROLE_KEY + API_BASE_URL/EMAIL/PASSWORD.
# Vercel Hobby 호환: 이메일 fallback은 매일 00:00 UTC, 적재는 매일 18:00 UTC.
# 관리자 즉시 발송은 인증된 POST kick을 사용하고 Cron은 pending 복구 경로다.
INGEST_SYSTEM_ACTOR_ID=

# SMTP 설정
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 백업 실패·보고 두절(dead-man) 경보 수신자(쉼표 구분). 비우면 경보를 건너뛴다.
# 두절 임계 시간은 BACKUP_DEADMAN_HOURS(기본 26)로 조정한다.
BACKUP_ALERT_EMAILS=

VERCEL_TOKEN=

# 365일 만료됨 생성일: 2026-07-20
# Token name: TOPIK admin
MIRROR_GITHUB_TOKEN=
