{
  "name": "topik-ai-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:client-secrets": "node ./scripts/check-client-secret-leaks.mjs",
    "check:client-source-secrets": "node ./scripts/check-client-source-secret-boundary.mjs",
    "check:message-history-boundary": "node ./scripts/check-message-history-boundary.mjs",
    "check:migration-boundary": "node ./scripts/check-migration-ownership-boundary.mjs",
    "check:transfer-sot-checklist": "node ./scripts/check-transfer-sot-checklist.mjs",
    "check:notification-cross-app-state": "node ./scripts/check-notification-cross-app-state.mjs",
    "check:notification-worker-smoke": "node ./scripts/check-notification-worker-smoke.mjs",
    "check:notification-production-evidence": "node ./scripts/check-notification-production-evidence.mjs",
    "check:vercel-worker-readiness": "node ./scripts/check-vercel-worker-readiness.mjs",
    "check:admin-transfer-completion": "node ./scripts/check-admin-transfer-completion-audit.mjs",
    "check:admin-verification-env": "node ./scripts/check-admin-verification-env.mjs",
    "check:mojibake": "node ./scripts/check-mojibake.mjs",
    "harness:check": "npm run check:mojibake && node ./scripts/check-doc-crosslinks.mjs && node ./scripts/check-route-doc-coverage.mjs && npm run check:message-history-boundary && npm run lint && npm run typecheck",
    "harness:admin-boundary": "npm run harness:admin-boundary:local",
    "harness:admin-boundary:local": "npm run check:transfer-sot-checklist && npm run check:admin-verification-env && npm run check:client-source-secrets && npm run check:message-history-boundary && npm run check:migration-boundary && npm run check:notification-cross-app-state && npm run check:notification-production-evidence",
    "harness:admin-boundary:production": "npm run harness:admin-boundary:local && npm run check:vercel-worker-readiness -- --strict-env && npm run check:notification-worker-smoke -- --dispatch && npm run check:notification-production-evidence -- --require && npm run check:admin-transfer-completion",
    "harness:admin-transfer:local": "npm run harness:admin-boundary:local && pnpm --dir ../topik-project/v13 harness:admin-boundary",
    "harness:e2e:smoke": "playwright test tests/e2e/table-text-alignment.spec.ts tests/e2e/table-action-column.spec.ts tests/e2e/operation-policies.spec.ts tests/e2e/system-metadata.spec.ts",
    "harness:full": "npm run harness:check && npm run build && npm run harness:e2e:smoke",
    "db:migrate": "node ./scripts/db/migrate.mjs",
    "db:migrate:status": "node ./scripts/db/migrate.mjs --status",
    "db:admin:migrate": "node ./scripts/db/admin-migrate.mjs",
    "db:admin:migrate:status": "node ./scripts/db/admin-migrate.mjs --status",
    "db:snapshot": "node ./scripts/db/schema-snapshot.mjs",
    "db:sql": "node ./scripts/db/run-sql.mjs",
    "lint": "set ESLINT_USE_FLAT_CONFIG=false&& eslint \"src/**/*.{ts,tsx}\" \"api/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:mock": "set VITE_SUPABASE_DISABLED=true&& playwright test tests/e2e/assessment-question-bank.spec.ts",
    "test:unit": "vitest run tests/unit",
    "etl:extract": "node ./scripts/etl/extract-problems.mjs",
    "etl:transform": "node ./scripts/etl/transform-questions.mjs",
    "etl:load": "node ./scripts/etl/load-questions.mjs",
    "etl:verify": "node ./scripts/etl/verify-backfill.mjs",
    "preview": "vite preview",
    "sync:tinymce": "node ./scripts/copy-tinymce-assets.mjs",
    "postinstall": "node ./scripts/copy-tinymce-assets.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.107.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "antd": "5.28.0",
    "axios": "^1.8.4",
    "nodemailer": "^9.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0",
    "tinymce": "^8.3.2",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "playwright": "^1.58.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "^2.1.9"
  }
}
