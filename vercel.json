{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/notifications/dispatch-email",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/writing-tasks/ingest",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
