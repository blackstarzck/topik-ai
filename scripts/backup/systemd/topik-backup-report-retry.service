[Unit]
Description=TOPIK backup report outbox retry
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=topikbackup
Group=topikbackup
EnvironmentFile=/etc/topik-backup/backup.env
ExecStart=/opt/topik-backup/topik-backup.sh flush
TimeoutStartSec=4min
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/topik-backup
UMask=0077
