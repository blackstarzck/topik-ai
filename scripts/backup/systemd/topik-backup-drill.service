[Unit]
Description=TOPIK monthly isolated restore drill
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=topikbackup
Group=topikbackup
SupplementaryGroups=docker
EnvironmentFile=/etc/topik-backup/backup.env
ExecStart=/opt/topik-backup/topik-backup.sh drill
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/topik-backup
UMask=0077
