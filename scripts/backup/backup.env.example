# TOPIK topik-prod 온프레미스 백업 설정 예시.
# 실제 파일은 서버의 설정 디렉터리에 mode 600으로 두고, 연결 문자열·비밀값은
# 절대 리포에 커밋하지 않는다. 비밀값 채움은 enter-secrets.sh를 사용한다.
#
# 사용자 권한(비루트) 구성 예시 — 2026-07-21 실제 배치 기준:
#   BACKUP_ROOT=/home/<계정>/topik-backup, 설정은 ${BACKUP_ROOT}/etc
# 루트 구성(원안)이라면 /srv/topik-backup, /etc/topik-backup을 사용한다.
BACKUP_ROOT=/home/CHANGE_ME/topik-backup
RESTIC_REPOSITORY=/home/CHANGE_ME/topik-backup/repository
RESTIC_PASSWORD_FILE=/home/CHANGE_ME/topik-backup/etc/restic-password
REPORT_SECRET_FILE=/home/CHANGE_ME/topik-backup/etc/report-secret
# 선택(권장): 있으면 동일 보고를 topik-dev 미러로도 독립 전송한다.
REPORT_MIRROR_SECRET_FILE=/home/CHANGE_ME/topik-backup/etc/report-mirror-secret
RCLONE_CONFIG=/home/CHANGE_ME/topik-backup/etc/rclone.conf
MIN_FREE_BYTES=53687091200

# topik-prod 세션 풀러 연결 문자열. 전용 읽기 롤 topik_backup을 사용한다
# (LOGIN + pg_read_all_data + BYPASSRLS; 생성 절차는 런북 참조).
SUPABASE_DB_URL=

# rclone 원격 이름(고정). 루트에서 전체 버킷이 보여야 한다.
STORAGE_RCLONE_REMOTE=topik-prod-storage

# 덤프 도구 컨테이너. prod PostgreSQL major와 일치하는 버전으로 핀하고
# 사전 pull 해 둔다(스크립트는 --pull never로 실행).
DUMP_IMAGE=public.ecr.aws/supabase/postgres:17.6.1.132

# Vercel 수신부(Production alias). 수신 API 미배포 동안은 전송 실패 →
# outbox 적재 → 5분 재시도가 정상 동작이다.
REPORT_URL=https://topik-ai.vercel.app/api/backups/report

# --- 월간 복원 점검(드릴) ---
# 55432는 이 서버에서 기존 서비스가 사용 중이므로 55433을 기본 예시로 한다.
# 드릴 스택 구성 파일은 scripts/backup/drill-stack/ 참조.
DRILL_STACK_DIR=/home/CHANGE_ME/topik-backup/drill-stack
DRILL_ENV_TEMPLATE=/home/CHANGE_ME/topik-backup/etc/drill.env
DRILL_COMPOSE_PROJECT=topik-prod-backup-drill
DRILL_DB_URL=postgres://supabase_admin:DRILL_PASSWORD@127.0.0.1:55433/postgres

# --- 타임아웃 재정의(초). 비우면 스크립트 기본값 사용 ---
# DUMP_TIMEOUT_SECONDS=1800
# STORAGE_SYNC_TIMEOUT_SECONDS=7200
# RESTIC_BACKUP_TIMEOUT_SECONDS=3600
# RESTIC_CHECK_TIMEOUT_SECONDS=14400
