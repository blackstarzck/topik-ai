# Non-secret settings. Install the real file as /etc/topik-backup/backup.env
# with mode 600. Never commit real connection strings or secret values.
BACKUP_ROOT=/srv/topik-backup
RESTIC_REPOSITORY=/srv/topik-backup/repository
RESTIC_PASSWORD_FILE=/etc/topik-backup/restic-password
REPORT_SECRET_FILE=/etc/topik-backup/report-secret
# Optional but recommended. When present, the same non-sensitive report is
# independently queued for the topik-dev mirror.
REPORT_MIRROR_SECRET_FILE=/etc/topik-backup/report-mirror-secret
RCLONE_CONFIG=/etc/topik-backup/rclone.conf
MIN_FREE_BYTES=53687091200

# topik-prod session-pooler connection string. Keep this server-only.
SUPABASE_DB_URL=

# rclone remote configured at the Supabase Storage S3 endpoint. Its root must
# expose every bucket so the script discovers current buckets on every run.
STORAGE_RCLONE_REMOTE=topik-prod-storage

# Deployed Vercel receiver. Only aggregate metadata is sent.
REPORT_URL=https://YOUR_ADMIN_DOMAIN/api/backups/report

# Dedicated, disposable official Supabase self-hosted stack for monthly drills.
DRILL_STACK_DIR=/srv/topik-backup/drill-stack
DRILL_ENV_TEMPLATE=/etc/topik-backup/drill.env
# Keep this project name separate from the existing topik-ai Compose project.
DRILL_COMPOSE_PROJECT=topik-prod-backup-drill
# This example assumes the drill stack uses POOLER_TENANT_ID=topik-drill and an
# unused loopback-only session port 55432. The URL must match drill.env.
DRILL_DB_URL=postgres://postgres.topik-drill:URL_ENCODED_DRILL_PASSWORD@127.0.0.1:55432/postgres
